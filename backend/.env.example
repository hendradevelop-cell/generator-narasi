# Salin menjadi .env lalu isi sesuai kebutuhan.
# Kosongkan LLM_API_KEY untuk mode mock/offline (template + heuristik) agar aplikasi tetap bisa dicoba tanpa API key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Kecepatan baca narasi bahasa Indonesia (kata per menit) untuk estimasi durasi.
WORDS_PER_MINUTE=150

# Ambang kemiripan teks (0-1) agar dua narasi dianggap duplikat (near-identical).
DUP_THRESHOLD=0.92
